@page
@model Firmeza.Pages.Client.IndexModel
@{
    ViewData["Title"] = "Product Catalog";
}

<div class="container mt-5">
    <!-- Header Section -->
    <div class="row mb-4 align-items-center">
        <div class="col-lg-6 mb-3 mb-lg-0">
            <h1 class="display-5 fw-bold">
                Product <span class="text-gradient">Catalog</span>
            </h1>
            <p class="text-muted mb-0">Discover our premium collection</p>
        </div>
        <div class="col-lg-6 text-lg-end">
            <a asp-page="/Client/Cart" class="btn btn-warning btn-lg position-relative">
                <span style="font-size: 1.25rem; margin-right: 0.5rem;">🛒</span>
                Shopping Cart
                @if (Model.CartItemCount > 0)
                {
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill" 
                          style="background: linear-gradient(135deg, var(--danger-color), hsl(15, 90%, 55%)); animation: pulse 2s infinite;">
                        @Model.CartItemCount
                    </span>
                }
            </a>
        </div>
    </div>
    
    <!-- Search Bar -->
    <div class="row mb-5">
        <div class="col-lg-8 mx-auto">
            <div class="search-container">
                <div class="input-group input-group-lg shadow-sm">
                    <span class="input-group-text bg-white border-end-0" style="font-size: 1.25rem;">🔍</span>
                    <input type="text" class="form-control border-start-0 ps-0" id="searchInput" 
                           placeholder="Search products by name or type..." 
                           onkeyup="filterProducts()" 
                           style="border-radius: 0 var(--radius-md) var(--radius-md) 0 !important;">
                </div>
            </div>
        </div>
    </div>

    <hr class="mb-5" style="opacity: 0.1;" />

    <!-- Products Grid -->
    <div class="row" id="productsGrid">
        @if (!Model.Products.Any())
        {
            <div class="col-12">
                <div class="alert alert-info d-flex align-items-center" role="alert">
                    <span style="font-size: 2rem; margin-right: 1rem;">ℹ️</span>
                    <div>
                        <strong>No products available</strong><br/>
                        No products are currently in stock. Please check back later!
                    </div>
                </div>
            </div>
        }
        else
        {
            @foreach (var product in Model.Products)
            {
                <div class="col-lg-4 col-md-6 mb-4 product-item" data-name="@product.Name.ToLower()" data-type="@product.Type.ToLower()">
                    <div class="card h-100 product-card animate-on-scroll">
                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                        {
                            <div class="product-image-wrapper">
                                <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height: 240px; object-fit: cover;">
                                <div class="product-overlay">
                                    <span class="quick-view-badge">Quick View</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="product-image-wrapper" style="height: 240px; background: linear-gradient(135deg, #f0f0f0, #e0e0e0); display: flex; align-items: center; justify-content: center;">
                                <span style="font-size: 4rem; opacity: 0.3;">📦</span>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <div class="mb-2">
                                <span class="badge rounded-pill px-3 py-2" 
                                      style="background: linear-gradient(135deg, var(--primary-color), var(--primary-light)); font-size: 0.75rem; font-weight: 600;">
                                    @product.Type
                                </span>
                            </div>
                            <h4 class="card-title mb-3">@product.Name</h4>
                            <h5 class="card-subtitle text-success fw-bold mb-3" style="font-size: 1.5rem;">
                                @product.Price.ToString("C", new System.Globalization.CultureInfo("en-US"))
                            </h5>
                            <p class="card-text text-muted mb-3 flex-grow-1">@product.Description</p>
                            
                            <div class="stock-info mb-3 d-flex align-items-center gap-2">
                                @if (product.Stock > 10)
                                {
                                    <span class="badge bg-success-subtle text-success px-3 py-2">
                                        ✓ In Stock (@product.Stock available)
                                    </span>
                                }
                                else if (product.Stock > 0)
                                {
                                    <span class="badge bg-warning-subtle text-warning px-3 py-2">
                                        ⚠ Low Stock (@product.Stock left)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger px-3 py-2">
                                        ✗ Out of Stock
                                    </span>
                                }
                            </div>
                        </div>
                        <div class="card-footer bg-white border-0 pt-0">
                            <form method="post" asp-page-handler="AddToCart" class="add-to-cart-form">
                                <input type="hidden" name="productId" value="@product.Id" />
                                <div class="d-flex gap-2 align-items-end">
                                    <div class="flex-grow-1">
                                        <label class="form-label small text-muted mb-1">Quantity</label>
                                        <input type="number" name="quantity" value="1" min="1" max="@product.Stock" 
                                               class="form-control" @(product.Stock == 0 ? "disabled" : "") />
                                    </div>
                                    <button type="submit" class="btn btn-primary px-4" style="height: 46px;" @(product.Stock == 0 ? "disabled" : "")>
                                        <span style="font-size: 1.1rem;">🛒</span> Add
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
    
    <!-- No Results Message (Hidden by default) -->
    <div id="noResults" class="col-12 text-center py-5" style="display: none;">
        <div class="card border-0 shadow-sm p-5">
            <div style="font-size: 4rem; margin-bottom: 1rem;">😕</div>
            <h3 class="mb-3">No products found</h3>
            <p class="text-muted">Try adjusting your search terms</p>
        </div>
    </div>
</div>

<style>
    .product-card {
        transition: all 0.3s ease;
        border: none;
        overflow: hidden;
    }
    
    .product-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15) !important;
    }
    
    .product-image-wrapper {
        position: relative;
        overflow: hidden;
    }
    
    .product-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 128, 255, 0.9);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.3s ease;
    }
    
    .product-card:hover .product-overlay {
        opacity: 1;
    }
    
    .quick-view-badge {
        color: white;
        font-weight: 600;
        font-size: 1.25rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
    
    .search-container {
        animation: fadeIn 0.5s ease-out;
    }
    
    .input-group-text {
        border-radius: var(--radius-md) 0 0 var(--radius-md) !important;
    }
    
    .add-to-cart-form button[type="submit"]:hover:not(:disabled) {
        transform: scale(1.02);
    }
    
    .badge.bg-success-subtle {
        background: rgba(16, 185, 129, 0.1) !important;
        border: 1px solid rgba(16, 185, 129, 0.2);
    }
    
    .badge.bg-warning-subtle {
        background: rgba(245, 158, 11, 0.1) !important;
        border: 1px solid rgba(245, 158, 11, 0.2);
    }
    
    .badge.bg-danger-subtle {
        background: rgba(239, 68, 68, 0.1) !important;
        border: 1px solid rgba(239, 68, 68, 0.2);
    }
</style>

<script>
    function filterProducts() {
        const searchTerm = document.getElementById('searchInput').value.toLowerCase();
        const products = document.querySelectorAll('.product-item');
        let visibleCount = 0;
        
        products.forEach(product => {
            const name = product.dataset.name;
            const type = product.dataset.type;
            
            if (name.includes(searchTerm) || type.includes(searchTerm)) {
                product.style.display = '';
                visibleCount++;
            } else {
                product.style.display = 'none';
            }
        });
        
        // Show/hide no results message
        const noResults = document.getElementById('noResults');
        if (visibleCount === 0 && searchTerm !== '') {
            noResults.style.display = 'block';
        } else {
            noResults.style.display = 'none';
        }
    }
    
    // Show toast on form submission
    document.querySelectorAll('.add-to-cart-form').forEach(form => {
        form.addEventListener('submit', function(e) {
            const productName = this.closest('.card').querySelector('.card-title').textContent;
            setTimeout(() => {
                if (window.Toast) {
                    Toast.show(`${productName} added to cart!`, 'success');
                }
            }, 100);
        });
    });
</script>