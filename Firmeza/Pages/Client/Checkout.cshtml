@page
@model Firmeza.Pages.Client.CheckoutModel
@{
    ViewData["Title"] = "Checkout";
}

<div class="container mt-5">
    <h1>Checkout</h1>
    <hr />

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header">Shipping & User Details</div>
                <div class="card-body">
                    <p><strong>Name:</strong> @Model.CurrentClient.FullName</p>
                    <p><strong>Email:</strong> @Model.CurrentClient.Email</p>
                    <p><strong>Document:</strong> @Model.CurrentClient.Document</p>
                    <p><strong>Address:</strong> @Model.CurrentClient.Address</p>
                    <p><strong>Phone:</strong> @Model.CurrentClient.Phone</p>
                    <small class="text-muted">To update these details, please visit your profile settings.</small>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">Order Items</div>
                <ul class="list-group list-group-flush">
                    @foreach (var item in Model.CartItems)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="my-0">@item.Product!.Name</h6>
                                <small class="text-muted">Qty: @item.Quantity x @item.Product.Price.ToString("C", new System.Globalization.CultureInfo("en-US"))</small>
                            </div>
                            <span class="text-muted">@item.SubTotal.ToString("C", new System.Globalization.CultureInfo("en-US"))</span>
                        </li>
                    }
                    <li class="list-group-item d-flex justify-content-between">
                        <span>Total (USD)</span>
                        <strong>@Model.TotalGross.ToString("C", new System.Globalization.CultureInfo("en-US"))</strong>
                    </li>
                </ul>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Payment</h5>
                    <p class="card-text">Payment simulation. By clicking "Confirm Order", the purchase will be finalized.</p>
                    <form method="post">
                        <button type="submit" class="btn btn-success w-100 btn-lg">Confirm Order</button>
                    </form>
                    <a asp-page="/Client/Cart" class="btn btn-outline-secondary w-100 mt-2">Back to Cart</a>
                </div>
            </div>
        </div>
    </div>
</div>