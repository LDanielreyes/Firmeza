@page
@model Firmeza.Pages.Admin.Clients.IndexModel

@{
    ViewData["Title"] = "Client Management";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-10">
            <h1>@ViewData["Title"]</h1>
        </div>
        <div class="col-1 text-end">
            <a asp-page="../Dashboard/Index" class="btn btn-danger">
                back
            </a>
        </div>
    </div>

    <table class="table table-striped table-hover">
        <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ClientList[0].FullName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ClientList[0].Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ClientList[0].Phone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ClientList[0].Document)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ClientList[0].RegisterDate)
            </th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.ClientList) {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.FullName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Phone)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Document)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.RegisterDate)
                </td>
                <td>
                    <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-secondary">Details</a>
                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info">Edit</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>