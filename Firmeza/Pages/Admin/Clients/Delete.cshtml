@page
@model Firmeza.Pages.Admin.Clients.DeleteModel

@{
    ViewData["Title"] = "Delete Client";
}

<div class="container mt-4">
    <h1>@ViewData["Title"]</h1>

    <h3 class="text-danger">Are you sure you want to delete this client? This action is irreversible.</h3>
    <hr />
    
    <div>
        <dl class="row">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Client.FullName)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Client.FullName)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Client.Email)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Client.Email)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Client.Document)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Client.Document)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Client.RegisterDate)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Client.RegisterDate)
            </dd>
        </dl>

        <form method="post">
            <input type="hidden" asp-for="Client.Id" />
            <button type="submit" class="btn btn-danger">Confirm Delete</button>
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>