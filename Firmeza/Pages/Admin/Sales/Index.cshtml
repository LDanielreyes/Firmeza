@page
@model Firmeza.Pages.Admin.Sales.IndexModel

@{
    ViewData["Title"] = "Receipt Management";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-5">
            <h1>@ViewData["Title"]</h1>
        </div>
        <div class="col-4 text-end">
            <a asp-page="../Dashboard/Index" class="btn btn-danger">
                back
            </a>
        </div>
        <div class="col-3 text-end">
            <a asp-page="Create" class="btn btn-primary">Create New Receipt</a>
        </div>
    </div>

    <table class="table table-striped table-hover">
        <thead>
        <tr>
            <th>Receipt ID</th>
            <th>Client</th>
            <th>Date</th>
            <th>Gross Total</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.ReceiptList) {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Id)</td>
                <td>@Html.DisplayFor(modelItem => item.Client.FullName)</td>
                <td>@Html.DisplayFor(modelItem => item.ReceiptDate)</td>
                <td>@item.GrossTotal.ToString("C")</td>
                <td>
                    <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-secondary">Details</a>
                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info">Edit</a>
                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>