@page
@model Firmeza.Pages.Admin.Sales.CreateModel

@{
    ViewData["Title"] = "Register New Receipt (Simple)";
}

<div class="container mt-4">
    <h1>@ViewData["Title"]</h1>
    
    <hr />
    <div class="row">
        <div class="col-lg-8">
            <form method="post">
                <div asp-validation-summary="All" class="text-danger"></div>
                
                <h3 class="mt-4">1. Client Selection</h3>
                
                <div class="form-floating mb-3">
                    <select asp-for="ClientFullName" asp-items="Model.ClientOptions" class="form-select">
                        <option value="">-- Select Client --</option>
                    </select>
                    <label asp-for="ClientFullName"></label>
                    <span asp-validation-for="ClientFullName" class="text-danger"></span>
                </div>

                <h3 class="mt-5">2. Single Product Sale</h3>
                
                <div class="row">
                    <div class="col-md-7">
                        <div class="form-floating mb-3">
                            <select asp-for="Item.ProductId" asp-items="Model.ProductOptions" class="form-select">
                                <option value="">-- Select Product --</option>
                            </select>
                            <label asp-for="Item.ProductId">Product</label>
                            <span asp-validation-for="Item.ProductId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="form-floating mb-3">
                            <input asp-for="Item.Quantity" type="number" min="1" class="form-control" />
                            <label asp-for="Item.Quantity">Quantity</label>
                            <span asp-validation-for="Item.Quantity" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="mt-5">
                    <button type="submit" class="btn btn-success btn-lg">Register Receipt</button>
                    <a asp-page="Index" class="btn btn-secondary btn-lg">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}