@page
@model Firmeza.Pages.Admin.Sales.DeleteModel

@{
    ViewData["Title"] = "Delete Receipt";
}

<div class="container mt-4">
    <h1>@ViewData["Title"] (ID: @Model.Receipt.Id)</h1>

    <h3 class="text-danger">Are you sure you want to delete this receipt? This will also delete all associated line items and cannot be undone.</h3>
    <hr />

    <div>
        <dl class="row">
            <dt class="col-sm-3">
                Client:
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Receipt.Client.FullName)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Receipt.ReceiptDate)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Receipt.ReceiptDate)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Receipt.GrossTotal)
            </dt>
            <dd class="col-sm-9">
                @Model.Receipt.GrossTotal.ToString("C")
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Receipt.IvaTotal)
            </dt>
            <dd class="col-sm-9">
                @Model.Receipt.IvaTotal.ToString("C")
            </dd>
        </dl>

        <form method="post">
            <input type="hidden" asp-for="Receipt.Id" />
            <button type="submit" class="btn btn-danger">Confirm Deletion</button>
            <a asp-page="./Details" asp-route-id="@Model.Receipt.Id" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>