@page
@model Firmeza.Pages.Admin.Products.DeleteModel

@{
    ViewData["Title"] = "Delete Product";
}

<div class="container mt-4">
    <h1>@ViewData["Title"]</h1>

    <h3 class="text-danger">Are you sure you want to delete this product? This action cannot be undone.</h3>
    <hr />
    
    <div>
        <dl class="row">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Product.Name)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Product.Name)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Product.Type)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Product.Type)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Product.Price)
            </dt>
            <dd class="col-sm-9">
                @Model.Product.Price.ToString("C")
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Product.Stock)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Product.Stock)
            </dd>
        </dl>

        <form method="post">
            <input type="hidden" asp-for="Product.Id" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
