@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center" style="min-height: 70vh;">
            <div class="col-lg-6 mb-5 mb-lg-0">
                <div class="hero-content fade-in">
                    <h1 class="display-3 fw-bold mb-4">
                        Welcome to <span class="text-gradient">Firmeza</span>
                    </h1>
                    <p class="lead mb-4" style="font-size: 1.25rem; color: var(--text-light-secondary); line-height: 1.7;">
                        Discover premium products with unbeatable quality. Shop with confidence and experience excellence in every purchase.
                    </p>
                    <div class="d-flex gap-3 flex-wrap">
                        <a asp-page="/Client/Catalog" class="btn btn-primary btn-lg shadow-glow">
                            🛍️ Browse Catalog
                        </a>
                        <a asp-page="/Privacy" class="btn btn-outline-secondary btn-lg">
                            Learn More →
                        </a>
                    </div>
                    
                    <!-- Stats Section -->
                    <div class="row mt-5 pt-4">
                        <div class="col-4">
                            <div class="stat-item">
                                <h3 class="text-gradient fw-bold mb-1">500+</h3>
                                <p class="text-muted small mb-0">Products</p>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="stat-item">
                                <h3 class="text-gradient fw-bold mb-1">10k+</h3>
                                <p class="text-muted small mb-0">Happy Customers</p>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="stat-item">
                                <h3 class="text-gradient fw-bold mb-1">4.9★</h3>
                                <p class="text-muted small mb-0">Rating</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-6">
                <div class="hero-image-container slide-in">
                    <div class="floating-card">
                        <div class="card border-0 shadow-lg" style="background: linear-gradient(135deg, rgba(0, 128, 255, 0.1), rgba(0, 180, 216, 0.1)); backdrop-filter: blur(10px);">
                            <div class="card-body p-5 text-center">
                                <div class="mb-4" style="font-size: 5rem;">🎁</div>
                                <h3 class="mb-3">Special Offer!</h3>
                                <p class="text-muted mb-4">Get 20% off on your first purchase</p>
                                <a asp-page="/Client/Catalog" class="btn btn-success">Shop Now</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="features-section py-5 my-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold mb-3">Why Choose <span class="text-gradient">Firmeza</span>?</h2>
            <p class="lead text-muted">Experience shopping reimagined with our premium service</p>
        </div>
        
        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-card card h-100 border-0 shadow-sm text-center p-4">
                    <div class="feature-icon mb-3" style="font-size: 3.5rem;">🚚</div>
                    <h4 class="mb-3">Fast Delivery</h4>
                    <p class="text-muted">Get your orders delivered quickly and safely to your doorstep</p>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="feature-card card h-100 border-0 shadow-sm text-center p-4 animate-on-scroll">
                    <div class="feature-icon mb-3" style="font-size: 3.5rem;">💎</div>
                    <h4 class="mb-3">Premium Quality</h4>
                    <p class="text-muted">Only the finest products curated specially for you</p>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="feature-card card h-100 border-0 shadow-sm text-center p-4">
                    <div class="feature-icon mb-3" style="font-size: 3.5rem;">🔒</div>
                    <h4 class="mb-3">Secure Payment</h4>
                    <p class="text-muted">Shop with confidence using our encrypted payment system</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="cta-section py-5 mb-5">
    <div class="container">
        <div class="card border-0 shadow-lg overflow-hidden">
            <div class="card-body p-5" style="background: linear-gradient(135deg, hsl(210, 100%, 50%), hsl(195, 85%, 45%));">
                <div class="row align-items-center">
                    <div class="col-lg-8 mb-4 mb-lg-0">
                        <h2 class="text-white fw-bold mb-3">Ready to start shopping?</h2>
                        <p class="text-white mb-0 opacity-90" style="font-size: 1.1rem;">
                            Join thousands of satisfied customers and discover amazing products today!
                        </p>
                    </div>
                    <div class="col-lg-4 text-lg-end">
                        <a asp-page="/Client/Catalog" class="btn btn-light btn-lg px-5 shadow">
                            Get Started →
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .hero-section {
        padding: 3rem 0;
    }
    
    .floating-card {
        animation: float 3s ease-in-out infinite;
    }
    
    @@keyframes float {
        0%, 100% {
            transform: translateY(0px);
        }
        50% {
            transform: translateY(-20px);
        }
    }
    
    .stat-item {
        text-align: center;
    }
    
    .feature-card {
        transition: all 0.3s ease;
        cursor: pointer;
    }
    
    .feature-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15) !important;
    }
    
    .feature-icon {
        display: inline-block;
        transition: transform 0.3s ease;
    }
    
    .feature-card:hover .feature-icon {
        transform: scale(1.1) rotate(5deg);
    }
</style>